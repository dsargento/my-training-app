# Source du programme : chemin local vers le .xlsx OU lien Google Sheets
# (pour un lien Google, le partage doit être "Toute personne disposant du lien")
SHEET_SOURCE=./data/programme.xlsx
# Nom du programme (en tête de page). Pour changer de programme, change SHEET_SOURCE et PROGRAM_NAME :
# l'ancien est archivé automatiquement, l'XP, le journal et les records continuent.
PROGRAM_NAME=

# Clé API Claude (optionnelle : sans elle, l'appli marche avec un classement d'exercices basique et sans coach IA)
ANTHROPIC_API_KEY=

# Pseudo OpenPowerlifting (fin de l'URL openpowerlifting.org/u/...) pour la salle des trophées
OPENPOWERLIFTING_USER=

# Prochaine compétition (compte à rebours dans la salle des trophées)
NEXT_MEET_NAME=
NEXT_MEET_DATE=

# Mot de passe de la synchro et du coach (OBLIGATOIRE dès que l'appli est en ligne ; vide = tout ouvert, usage local)
SYNC_PASSWORD=

PORT=3000
